# Example configuration for RestJdbcProxy
# Copy this file to application.properties and update with your database settings

# JPA/Hibernate settings
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
logging.level.org.hibernate.SQL=INFO
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
logging.level.org.hibernate.type.descriptor.sql=trace

# Server configuration
server.servlet.contextPath=/rjp

# Database connections - Update with your database details
# Supports any JDBC-compatible database (PostgreSQL, MySQL, Oracle, SQL Server, etc.)
Db.connections=\
  {DB1:"${DB1_JDBC_URL}",\
  DB2:"${DB2_JDBC_URL}",\
  DB3:"${DB3_JDBC_URL}"}

# Example system/environment parameters. Store actual values outside Git.
# DB1_JDBC_URL=<set in environment or .db.env>
# DB2_JDBC_URL=<set in environment or .db.env>
# DB3_JDBC_URL=<set in environment or .db.env>

# Access descriptor JSON files location
json.folder.path=src/main/resources/access_descriptor

# Thread and connection pool limits
app.datasource.maximum-pool-size=10
app.async.max-threads-per-db=10
app.async.max-threads-total=100
app.async.queue-capacity=100
app.batch.max-threads-per-request=10

# CORS configuration
cors.allowCredentials=true
cors.allowedOrigins=http://localhost:4200,http://localhost:3000
cors.allowedMethods=GET,POST,PUT,DELETE
cors.allowedHeaders=*
cors.exposedHeaders=Authorization,Link
cors.maxAge=3600

# Example database-specific configurations:

# PostgreSQL example format:
# jdbc:postgresql://localhost:5432/mydb?user=<user>&password=<password>

# MySQL example format:
# jdbc:mysql://localhost:3306/mydb?user=<user>&password=<password>&useSSL=false

# SQL Server example format:
# jdbc:sqlserver://localhost:1433;databaseName=mydb;user=<user>;password=<password>

# Oracle example format:
# jdbc:oracle:thin:<user>/<password>@localhost:1521:xe
