### Demo raw SQL query. Requires app.demo-mode=true.
GET http://localhost:8080/rjp/query?connection=DB1&sqlQuery=select%20*%20from%20customer%20where%20id%3C800

### Stored function alias
POST http://localhost:8080/rjp/dynpst/test_pkh.tst_function
Content-Type: application/json

{
  "_rjp": {
    "connectionName": "DB1"
  },
  "params": {
    "aN": "123"
  }
}

### Prepared statement alias
POST http://localhost:8080/rjp/dynpst/prepared_statement
Content-Type: application/json

{
  "_rjp": {
    "connectionName": "DB1"
  },
  "params": {
    "AN": 7
  }
}

### Stored procedure with output parameters
POST http://localhost:8080/rjp/dynpst/test_pkh.proc_with_OutParam
Content-Type: application/json

{
  "_rjp": {
    "connectionName": "DB1"
  },
  "params": {
    "ID": 123,
    "NAME": "test",
    "P": "INPUT p parameter value"
  }
}

### Business parameter named connection is allowed inside params
POST http://localhost:8080/rjp/dynpst/prepared_statement
Content-Type: application/json

{
  "_rjp": {
    "connectionName": "DB1"
  },
  "params": {
    "connection": "business-value",
    "AN": 7
  }
}

### Batch prepared statement with mixed database routing
POST http://localhost:8080/rjp/batch/prepared_statement
Content-Type: application/json

[
  {
    "_rjp": {
      "connectionName": "DB1"
    },
    "params": {
      "AN": 3
    }
  },
  {
    "_rjp": {
      "connectionName": "DB2"
    },
    "params": {
      "AN": 7
    }
  },
  {
    "_rjp": {
      "connectionName": "DB3"
    },
    "params": {
      "AN": 9
    }
  }
]

### Batch stored function
POST http://localhost:8080/rjp/batch/test_pkh.tst_function
Content-Type: application/json

[
  {
    "_rjp": {
      "connectionName": "DB1"
    },
    "params": {
      "aN": "123"
    }
  },
  {
    "_rjp": {
      "connectionName": "DB2"
    },
    "params": {
      "aN": "23"
    }
  },
  {
    "_rjp": {
      "connectionName": "DB1"
    },
    "params": {
      "aN": "3"
    }
  }
]

### Start async batch task
POST http://localhost:8080/rjp/startAsyncTask/test_pkh.tst_function
Content-Type: application/json

[
  {
    "_rjp": {
      "connectionName": "DB1"
    },
    "params": {
      "aN": "123"
    }
  },
  {
    "_rjp": {
      "connectionName": "DB2"
    },
    "params": {
      "aN": "23"
    }
  }
]

### Async task status
GET http://localhost:8080/rjp/tasksStatus

### Async task result
GET http://localhost:8080/rjp/taskResult/{{taskId}}

### Async task remove
GET http://localhost:8080/rjp/taskRemove/{{taskId}}

### Actuator metrics
GET http://localhost:8080/rjp/actuator/metrics/http.requests.rjp.dynpst.count
